const mongoose = require("mongoose");

const documentSchema = new mongoose.Schema(
  {
    vendorId: {
      type: mongoose.Schema.Types.ObjectId,
      ref: "Vendor",
      required: [true, "Vendor ID is required"],
      index: true,
    },
    documentName: {
      type: String,
      required: [true, "Document name is required"],
      trim: true,
      maxlength: [200, "Document name cannot exceed 200 characters"],
    },
    fileName: {
      type: String,
      required: true,
      trim: true,
    },
    filePath: {
      type: String,
      required: true,
    },
    fileSize: {
      type: Number,
      required: true,
      min: [0, "File size cannot be negative"],
    },
    mimeType: {
      type: String,
      required: true,
      lowercase: true,
    },
    category: {
      type: String,
      enum: ["MOU", "Business", "Project", "Legal", "Other"],
      default: "Other",
      required: true,
    },
    status: {
      type: String,
      enum: ["Uploaded", "Verified", "Rejected"],
      default: "Uploaded",
    },
    uploadedAt: {
      type: Date,
      default: Date.now,
    },
    // Optional: store a public URL or CDN link
    publicUrl: {
      type: String,
      default: "",
    },
    // Optional: store extracted text or description
    description: {
      type: String,
      trim: true,
      maxlength: [500, "Description cannot exceed 500 characters"],
    },
  },
  {
    timestamps: true, // adds createdAt and updatedAt automatically
    toJSON: { virtuals: true },
    toObject: { virtuals: true },
  }
);

// Compound index for faster queries by vendor + category
documentSchema.index({ vendorId: 1, category: 1 });

// Virtual: file extension
documentSchema.virtual("extension").get(function () {
  const parts = this.fileName.split(".");
  return parts.length > 1 ? parts.pop().toLowerCase() : "";
});

// Virtual: human-readable size (can be computed in frontend, but optional)
documentSchema.virtual("sizeFormatted").get(function () {
  const bytes = this.fileSize;
  if (bytes === 0) return "0 Bytes";
  const k = 1024;
  const sizes = ["Bytes", "KB", "MB", "GB"];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + " " + sizes[i];
});

// Prevent duplicate file uploads (same vendor + same file name + same size)
documentSchema.index({ vendorId: 1, fileName: 1, fileSize: 1 }, { unique: true, sparse: true });

module.exports = mongoose.model("Document", documentSchema);